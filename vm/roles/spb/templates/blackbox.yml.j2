modules:
{% for name,port in [('uk_primary',10811),('uk_backup',10812),('split_default',10813),('ru_direct',10814)] %}
  {{ name }}:
    prober: http
    timeout: 12s
    http:
      valid_status_codes: [200]
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
      proxy_url: socks5://127.0.0.1:{{ port }}
      follow_redirects: false
      body_size_limit: 65536
      fail_if_body_not_matches_regexp:
        - '^{{ (ansible_host if name == "ru_direct" else spb_metrics_source) | regex_escape }}$'
{% endfor %}
  ru_http:
    prober: http
    timeout: 12s
    http:
      valid_status_codes: [200]
      preferred_ip_protocol: ip4
      ip_protocol_fallback: false
      proxy_url: socks5://127.0.0.1:10813
      follow_redirects: true
      body_size_limit: 1048576
