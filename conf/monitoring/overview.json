{
  "uid": "hm-services",
  "title": "Services / Overview",
  "description": "A compact service view. Service and Region apply consistently to all panels; detailed Gateway checks and traffic are collapsed.",
  "tags": [
    "hackamonth",
    "operations",
    "vpn"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "title": "Triage guide",
      "url": "https://github.com/sidosera/hm-gitops#operating-the-dashboard",
      "type": "link",
      "icon": "book",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "Service",
        "type": "custom",
        "query": "Gateway : gateway,Website : website,Observability : observability",
        "multi": false,
        "includeAll": true,
        "allValue": "gateway|website|observability",
        "current": {
          "selected": true,
          "text": "Gateway",
          "value": "gateway"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": false
          },
          {
            "text": "Gateway",
            "value": "gateway",
            "selected": true
          },
          {
            "text": "Website",
            "value": "website",
            "selected": false
          },
          {
            "text": "Observability",
            "value": "observability",
            "selected": false
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "region",
        "label": "Region",
        "type": "custom",
        "query": "uk,spb",
        "multi": false,
        "includeAll": true,
        "allValue": "uk|spb",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "uk",
            "value": "uk",
            "selected": false
          },
          {
            "text": "spb",
            "value": "spb",
            "selected": false
          }
        ],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Service overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Select a **service** and **region**. All panels follow that selection. Clients and transport checks apply to Gateway; **N/A** means that signal is not collected for the selection."
      }
    },
    {
      "id": 2,
      "title": "Ready instances",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "description": "Ready / scheduled non-terminal pods for the selected service and region. This is workload readiness, not end-to-end availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:ready{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Ready",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "count(hm:service_instance:info{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Scheduled",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Connected clients",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "description": "Gateway only: fresh authenticated source-IP estimates, shown separately by region. Shared IPs make this a lower bound; do not sum across regions as unique people.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "xray_active_client_ips{service=~\"${service_name:regex}\",region=~\"${region:regex}\"} and on(instance) (xray_online_scrape_success{service=~\"${service_name:regex}\",region=~\"${region:regex}\"} == 1) and on(instance) (up{job=~\"node|spb-node\",region=~\"${region:regex}\"} == 1) and on(instance) ((time() - node_textfile_mtime_seconds{job=~\"node|spb-node\",region=~\"${region:regex}\",file=\"/textfile/xray_online.prom\"}) < 60)",
          "legendFormat": "{{region}}",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Service memory",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "description": "Memory working set of selected service pods, including sidecars.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:memory_bytes{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Working set",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Host RAM available",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 2,
        "w": 6,
        "h": 4
      },
      "description": "Available RAM on hosts running the selected service. Shared host capacity, not memory allocated to this service.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(100 * node_memory_MemAvailable_bytes{job=~\"node|spb-node\",region=~\"${region:regex}\"} / node_memory_MemTotal_bytes{job=~\"node|spb-node\",region=~\"${region:regex}\"}) and on(node) hm:service_instance:info{service=~\"${service_name:regex}\",region=~\"${region:regex}\"}",
          "legendFormat": "{{region}}",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Service CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "CPU cores used by the selected service; two-minute rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(region) (hm:service_instance:cpu_cores{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "{{region}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Service memory over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(region) (hm:service_instance:memory_bytes{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "{{region}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Details \u00b7 connectivity, traffic & capacity",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 20,
          "title": "Gateway paths \u00b7 checked from SPB",
          "type": "state-timeline",
          "gridPos": {
            "x": 0,
            "y": 13,
            "w": 12,
            "h": 6
          },
          "description": "Authenticated checks from SPB. Region filters the Gateway deployment under test: REALITY/HTTPS target UK; direct control and routing checks target SPB. N/A for other services.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "probe_success{service=~\"${service_name:regex}\",target_region=~\"${region:regex}\"} and on(instance,check) (up{job=\"spb-probes\",service=~\"${service_name:regex}\",target_region=~\"${region:regex}\"} == 1)",
              "legendFormat": "{{target_region}} \u00b7 {{check}}",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Failed",
                      "color": "red"
                    },
                    "1": {
                      "text": "Passed",
                      "color": "green"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showValue": "auto",
            "alignValue": "left",
            "mergeValues": true,
            "rowHeight": 0.8,
            "legend": {
              "showLegend": false
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          }
        },
        {
          "id": 21,
          "title": "Gateway traffic \u00b7 UK measurement",
          "type": "timeseries",
          "gridPos": {
            "x": 12,
            "y": 13,
            "w": 12,
            "h": 6
          },
          "description": "Traffic counters are currently collected at the UK Gateway only. SPB or another service shows N/A; these are not fleet-wide totals.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(rate(xray_traffic_downlink_bytes_total{service=~\"${service_name:regex}\",region=~\"${region:regex}\",dimension=\"inbound\",target=~\"reality|reality-legacy|https-backup\"}[$__rate_interval])) * 8",
              "legendFormat": "Download",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "refId": "B",
              "expr": "sum(rate(xray_traffic_uplink_bytes_total{service=~\"${service_name:regex}\",region=~\"${region:regex}\",dimension=\"inbound\",target=~\"reality|reality-legacy|https-backup\"}[$__rate_interval])) * 8",
              "legendFormat": "Upload",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bps",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": []
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 22,
          "title": "Service restarts \u00b7 last hour",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 19,
            "w": 12,
            "h": 6
          },
          "description": "Restarts for currently scheduled instances of the selected service.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(region) (hm:service_instance:restarts_1h{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
              "legendFormat": "{{region}}",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": []
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 23,
          "title": "Disk available on service hosts",
          "type": "stat",
          "gridPos": {
            "x": 12,
            "y": 19,
            "w": 12,
            "h": 6
          },
          "description": "Shared host filesystem capacity on the selected service hosts.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "(100 * node_filesystem_avail_bytes{job=~\"node|spb-node\",region=~\"${region:regex}\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=~\"node|spb-node\",region=~\"${region:regex}\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}) and on(node) hm:service_instance:info{service=~\"${service_name:regex}\",region=~\"${region:regex}\"}",
              "legendFormat": "{{region}}",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "percent",
              "decimals": 1,
              "noValue": "No data",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": []
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "orientation": "auto",
            "colorMode": "none",
            "graphMode": "none",
            "textMode": "value_and_name",
            "wideLayout": true,
            "justifyMode": "auto"
          }
        },
        {
          "id": 8,
          "title": "Regional instances",
          "type": "table",
          "gridPos": {
            "x": 0,
            "y": 25,
            "w": 24,
            "h": 5
          },
          "description": "Only the selected service and region; Ready is Kubernetes pod readiness.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "hm:service_instance:ready{service=~\"${service_name:regex}\",region=~\"${region:regex}\"}",
              "legendFormat": "",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "decimals": 0,
              "noValue": "No instances",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Not ready",
                      "color": "red"
                    },
                    "1": {
                      "text": "Ready",
                      "color": "green"
                    }
                  }
                }
              ]
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Ready"
                },
                "properties": [
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-text"
                    }
                  }
                ]
              }
            ]
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false
            }
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "namespace": true,
                  "service": true,
                  "node": true
                },
                "indexByName": {
                  "region": 0,
                  "pod": 1,
                  "Value": 2
                },
                "renameByName": {
                  "region": "Region",
                  "pod": "Instance",
                  "Value": "Ready"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
