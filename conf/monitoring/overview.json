{
  "uid": "hm-services",
  "title": "Services / Overview",
  "description": "Generic workload health and resource usage, discovered by service identity and region.",
  "tags": [
    "hackamonth",
    "services"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 9,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "title": "VPN",
      "url": "/status/d/hm-vpn/vpn-operations",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Inventory",
      "url": "/status/d/hm-inventory/inventory-capacity",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(count by (service) (hm:service_instance:info))",
          "refId": "service_name"
        },
        "definition": "query_result(count by (service) (hm:service_instance:info))",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false,
        "regex": "/service=\"([^\"]+)\"/"
      },
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hm:service_instance:info, region)",
          "refId": "region"
        },
        "definition": "label_values(hm:service_instance:info, region)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Service overview",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Workload readiness and resource usage for any **service** and **region**. Use **VPN** for client connectivity and **Inventory** for host capacity."
      }
    },
    {
      "id": 2,
      "title": "Ready instances",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 8,
        "h": 4
      },
      "description": "Ready / scheduled non-terminal pods for the selected service and region. This is workload readiness, not end-to-end availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:ready{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Ready",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "count(hm:service_instance:info{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Scheduled",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 9,
      "title": "Restarts \u00b7 last hour",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 2,
        "w": 8,
        "h": 4
      },
      "description": "Container restarts in currently scheduled instances over a rolling hour. Pod replacements are not restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:restarts_1h{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Restarts",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "Service memory",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 2,
        "w": 8,
        "h": 4
      },
      "description": "Memory working set of selected service pods, including sidecars.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:memory_bytes{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "Working set",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Service CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "CPU cores used by the selected service; two-minute rates.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,region) (hm:service_instance:cpu_cores{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "{{service}} / {{region}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "decimals": 3,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Service memory over time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 6
      },
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service,region) (hm:service_instance:memory_bytes{service=~\"${service_name:regex}\",region=~\"${region:regex}\"})",
          "legendFormat": "{{service}} / {{region}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Details \u00b7 workload instances",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 8,
          "title": "Regional instances",
          "type": "table",
          "gridPos": {
            "x": 0,
            "y": 13,
            "w": 24,
            "h": 5
          },
          "description": "Only the selected service and region; Ready is Kubernetes pod readiness.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "hm:service_instance:ready{service=~\"${service_name:regex}\",region=~\"${region:regex}\"}",
              "legendFormat": "",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "decimals": 0,
              "noValue": "No instances",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Not ready",
                      "color": "red"
                    },
                    "1": {
                      "text": "Ready",
                      "color": "green"
                    }
                  }
                }
              ]
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Ready"
                },
                "properties": [
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-text"
                    }
                  }
                ]
              }
            ]
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showHeader": true,
            "cellHeight": "sm",
            "footer": {
              "show": false
            }
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "namespace": true,
                  "service": false,
                  "node": true
                },
                "indexByName": {
                  "service": 0,
                  "region": 1,
                  "pod": 2,
                  "Value": 3
                },
                "renameByName": {
                  "region": "Region",
                  "pod": "Instance",
                  "Value": "Ready",
                  "service": "Service"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
