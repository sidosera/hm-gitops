      "description": "",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(device) (rate(node_network_transmit_bytes_total{job=\"spb-node\",device=~\"ens.*|enp.*|eth.*\"}[$__rate_interval])) * 8",
          "legendFormat": "SPB physical network",
          "instant": false,
          "range": true,
