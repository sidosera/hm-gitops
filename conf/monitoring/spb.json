    {
      "id": 7,
      "title": "ROUTING & OBSERVATION SCOPE",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "SPB is a tainted K3s worker using the same Flux deployment and node-exporter DaemonSet as the upstream host. Prometheus/Grafana are central. Explicit Russian domains exit SPB; everything else uses an upstream transport. Each probe checks the actual exit IP. A datacenter probe cannot represent every residential/mobile ISP."
      }
    },
    {
      "id": 8,
      "title": "Connection checks over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 7
      },
      "description": "1 = expected response and exit IP, 0 = failed. Scrape failure leaves a gap.",
      "targets": [
        {
          "refId": "A",
          "expr": "probe_success{job=\"spb-probes\"}",
          "legendFormat": "{{check}}",
          "instant": false,
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "UNKNOWN",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
