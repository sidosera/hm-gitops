{
  "uid": "hm-vpn",
  "title": "VPN / Operations",
  "description": "VPN entry health and website connectivity from the probe zone, directly and through VPN.",
  "tags": [
    "hackamonth",
    "vpn"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 5,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "title": "Services",
      "url": "/status/d/hm-services/services-overview",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    },
    {
      "title": "Inventory",
      "url": "/status/d/hm-inventory/inventory-capacity",
      "type": "link",
      "icon": "dashboard",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(node_uname_info{cluster!=\"\"}, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(node_uname_info{cluster!=\"\"}, cluster)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "hm-cluster",
          "value": "hm-cluster",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "entry_zone",
        "label": "Entry zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hm:service_instance:info{cluster=~\"${cluster:regex}\",service=\"gateway\"}, zone)",
          "refId": "entry_zone"
        },
        "definition": "label_values(hm:service_instance:info{cluster=~\"${cluster:regex}\",service=\"gateway\"}, zone)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "source_zone",
        "label": "Probe zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\"}, source_zone)",
          "refId": "source_zone"
        },
        "definition": "label_values(up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\"}, source_zone)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": ".*",
        "current": {
          "text": "ru-spb-1",
          "value": "ru-spb-1",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "site",
        "label": "Website",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\"}, site)",
          "refId": "site"
        },
        "definition": "label_values(up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\"}, site)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all",
          "selected": true
        },
        "options": [],
        "hide": 0,
        "skipUrlSync": false
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "VPN operations",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "Website access uses a separate VPN client connecting through the **public Gateway listener**. **Probe source / destination / Website** scope those checks. Entry readiness and client counts use **Entry zone**."
      }
    },
    {
      "id": 2,
      "title": "Entry instances ready",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 4
      },
      "description": "Ready / scheduled Gateway pods in the selected entry zone. Workload readiness does not establish end-to-end client connectivity.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hm:service_instance:ready{cluster=~\"${cluster:regex}\",service=\"gateway\",zone=~\"${entry_zone:regex}\"})",
          "legendFormat": "Ready",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "count(hm:service_instance:info{cluster=~\"${cluster:regex}\",service=\"gateway\",zone=~\"${entry_zone:regex}\"})",
          "legendFormat": "Scheduled",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "No instances",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Connected client IPs",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 2,
        "w": 12,
        "h": 4
      },
      "description": "Gateway only: fresh authenticated source-IP estimates, shown separately by zone. Shared IPs make this a lower bound; do not sum across zones as unique people.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "xray_active_client_ips{cluster=~\"${cluster:regex}\",service=\"gateway\",zone=~\"${entry_zone:regex}\"} and on(instance) (xray_online_scrape_success{cluster=~\"${cluster:regex}\",service=\"gateway\",zone=~\"${entry_zone:regex}\"} == 1) and on(instance) (up{cluster=~\"${cluster:regex}\",zone=~\"${entry_zone:regex}\"} == 1) and on(instance) ((time() - node_textfile_mtime_seconds{cluster=~\"${cluster:regex}\",zone=~\"${entry_zone:regex}\",file=\"/textfile/xray_online.prom\"}) < 60)",
          "legendFormat": "{{zone}}",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "N/A",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": []
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value_and_name",
        "wideLayout": true,
        "justifyMode": "auto"
      }
    },
    {
      "id": 30,
      "title": "Website connectivity \u00b7 last minute",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 10
      },
      "description": "Rows are websites; columns compare direct access with the public VPN from the selected probe zone. Each cell is the minimum successful-page result in the last 60 seconds: any failed check is red. Missing or failed telemetry is gray (No data). Checks run once per minute. VPN uses the UK public entry; direct access and DNS use the SPB provider network.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by(site,access) (min_over_time(probe_success{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\",site=~\"${site:regex}\"}[1m]) and on(cluster,instance,source_zone,access,site,check) (up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\",site=~\"${site:regex}\"} == 1) and on(cluster,instance,source_zone,access,site,check) (timestamp(up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\",site=~\"${site:regex}\"}) > time() - 60)) or on(site,access) (0 * max by(site,access) (up{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\",site=~\"${site:regex}\"}) - 1)",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "noValue": "No data",
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "color-background"
            }
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unreachable",
                  "color": "red"
                },
                "1": {
                  "text": "Reachable",
                  "color": "green"
                },
                "-1": {
                  "text": "No data",
                  "color": "#8e8e8e"
                }
              }
            },
            {
              "type": "special",
              "options": {
                "match": "null",
                "result": {
                  "text": "No data",
                  "color": "#8e8e8e"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8e8e",
                "value": null
              },
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Website"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "auto"
                }
              },
              {
                "id": "custom.align",
                "value": "left"
              }
            ]
          }
        ]
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "showHeader": true,
        "cellHeight": "lg",
        "footer": {
          "show": false
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "access",
            "rowField": "site",
            "valueField": "Value",
            "emptyValue": "null"
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "site\\access": "Website",
              "direct": "Direct",
              "vpn": "VPN"
            },
            "indexByName": {
              "site\\access": 0,
              "direct": 1,
              "vpn": 2
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Details \u00b7 transport diagnostics",
      "collapsed": true,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 20,
          "title": "Transport diagnostics",
          "type": "state-timeline",
          "gridPos": {
            "x": 0,
            "y": 17,
            "w": 24,
            "h": 6
          },
          "description": "Authenticated synthetic checks, labelled by observer, destination and path. These datacenter checks do not prove connectivity from every client ISP.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "probe_success{cluster=~\"${cluster:regex}\",service=\"gateway\",source_zone!=\"\",target_zone!=\"\",source_zone=~\"${source_zone:regex}\"} and on(instance,check) (up{cluster=~\"${cluster:regex}\",service=\"gateway\",source_zone!=\"\",target_zone!=\"\",source_zone=~\"${source_zone:regex}\"} == 1)",
              "legendFormat": "{{source_zone}} \u2192 {{target_zone}} / {{check}}",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Failed",
                      "color": "red"
                    },
                    "1": {
                      "text": "Passed",
                      "color": "green"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showValue": "auto",
            "alignValue": "left",
            "mergeValues": true,
            "rowHeight": 0.8,
            "legend": {
              "showLegend": false
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          }
        },
        {
          "id": 21,
          "title": "Transport traffic by measurement zone",
          "type": "timeseries",
          "gridPos": {
            "x": 0,
            "y": 23,
            "w": 24,
            "h": 6
          },
          "description": "Transport counters where an Xray exporter is deployed. Forwarded and direct client traffic can overlap between zones; do not sum as unique client traffic. Missing exporters are unmeasured.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum by(cluster,zone,target) (rate(xray_traffic_downlink_bytes_total{cluster=~\"${cluster:regex}\",service=\"gateway\",dimension=\"inbound\"}[$__rate_interval])) * 8",
              "legendFormat": "{{zone}} / {{target}} \u00b7 Download",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            },
            {
              "refId": "B",
              "expr": "sum by(cluster,zone,target) (rate(xray_traffic_uplink_bytes_total{cluster=~\"${cluster:regex}\",service=\"gateway\",dimension=\"inbound\"}[$__rate_interval])) * 8",
              "legendFormat": "{{zone}} / {{target}} \u00b7 Upload",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bps",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": []
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "legend": {
              "displayMode": "list",
              "placement": "bottom",
              "calcs": []
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 31,
          "title": "Website HTTP response status",
          "type": "table",
          "gridPos": {
            "x": 0,
            "y": 29,
            "w": 24,
            "h": 7
          },
          "description": "Separate client \u2192 public VLESS/REALITY listener \u2192 actual egress policy \u2192 target HTTPS page. Requires valid TLS, HTTP 200 and the expected site marker. HTTP 403 or a challenge is a failure; see status codes in Details.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "probe_http_status_code{cluster=~\"${cluster:regex}\",job=\"vpn-client-probes\",check=\"client-web\",source_zone=~\"${source_zone:regex}\",site=~\"${site:regex}\"}",
              "legendFormat": "",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              },
              "format": "table"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": []
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showHeader": true
          },
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "__name__": true,
                  "instance": true,
                  "job": true,
                  "module": true,
                  "probe_scope": true,
                  "check": true,
                  "region": true,
                  "service": true,
                  "target_service": true,
                  "cluster": true,
                  "pop": true,
                  "node": true,
                  "host": true,
                  "machine": true,
                  "country": true,
                  "source_country": true,
                  "source_pop": true,
                  "target_country": true,
                  "target_pop": true,
                  "source_zone": true,
                  "target_zone": true,
                  "zone": true
                },
                "indexByName": {
                  "site": 0,
                  "access": 1,
                  "Value": 2
                },
                "renameByName": {
                  "source_zone": "Probe source",
                  "target_zone": "Gateway entry",
                  "site": "Website",
                  "Value": "HTTP status",
                  "zone": "Zone",
                  "access": "Access"
                }
              }
            }
          ]
        },
        {
          "id": 32,
          "title": "Public client exit-IP verification",
          "type": "state-timeline",
          "gridPos": {
            "x": 0,
            "y": 36,
            "w": 24,
            "h": 6
          },
          "description": "Uses the same independent client and public VPN entry as website checks, then verifies the expected egress IP.",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "probe_success{cluster=~\"${cluster:regex}\",probe_scope=\"public-client\",check=\"client-exit\",source_zone=~\"${source_zone:regex}\"} and on(instance,source_zone,target_zone,check,site) (up{cluster=~\"${cluster:regex}\",probe_scope=\"public-client\",check=\"client-exit\",source_zone=~\"${source_zone:regex}\"} == 1)",
              "legendFormat": "{{source_zone}} \u2192 {{target_zone}} / exit IP",
              "editorMode": "code",
              "instant": false,
              "range": true,
              "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 1,
              "noValue": "N/A",
              "color": {
                "mode": "palette-classic"
              },
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "Failed",
                      "color": "red"
                    },
                    "1": {
                      "text": "Passed",
                      "color": "green"
                    }
                  }
                }
              ]
            },
            "overrides": []
          },
          "maxDataPoints": 600,
          "interval": "30s",
          "options": {
            "showValue": "auto",
            "alignValue": "left",
            "mergeValues": true,
            "rowHeight": 0.8,
            "legend": {
              "showLegend": false
            },
            "tooltip": {
              "mode": "single",
              "sort": "none"
            }
          }
        }
      ]
    }
  ]
}
