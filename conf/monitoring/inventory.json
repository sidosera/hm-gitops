{
  "uid": "hm-inventory",
  "title": "Hosts",
  "description": "Host availability grouped by cluster and zone, CPU execution, available RAM and mirrored network traffic. Fleet membership comes from configured scrape targets.",
  "tags": [
    "HM"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 6,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ],
    "time_options": [
      "15m",
      "1h",
      "3h",
      "6h",
      "12h",
      "24h",
      "2d",
      "7d"
    ]
  },
  "editable": false,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "links": [
    {
      "title": "Hosts",
      "url": "/status/d/hm-inventory/hosts",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Proxy",
      "url": "/status/d/hm-proxy/proxy",
      "type": "link",
      "keepTime": true,
      "includeVars": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hm:node:info{cluster!=\"\"}, cluster)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {
          "text": "hm-cluster",
          "value": "hm-cluster"
        },
        "hide": 0
      },
      {
        "name": "zone",
        "label": "Zone",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(hm:node:info{cluster=~\"${cluster:regex}\",zone!=\"\"}, zone)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*"
      },
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "query_result(label_join(hm:node:info{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\"}, \"host_label\", \" \u00b7 \", \"machine\", \"node\", \"host\"))",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "options": [],
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "allValue": ".*",
        "regex": "/host=\"(?<value>[^\"]+)\"|host_label=\"(?<text>[^\"]+)\"/g"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 11,
      "title": "${cluster} \u00b7 ${zone}",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 5
      },
      "description": "Configured hosts stay visible when unreachable. Green: fresh successful kubelet scrape; red: down. Click a tile to select the host; Host shows machine IP, node name and slot.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hm:node:info{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\",host=~`${host:regex}`} * on(cluster,node) group_left() hm:node:up",
          "refId": "A",
          "legendFormat": "{{machine}}",
          "range": false,
          "instant": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "Unknown",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ],
          "links": [
            {
              "title": "Inspect ${__field.labels.machine} \u00b7 ${__field.labels.node} \u00b7 ${__field.labels.host}",
              "url": "/status/d/hm-inventory/hosts?${__url_time_range}&var-cluster=${__field.labels.cluster:percentencode}&var-zone=${__field.labels.zone:percentencode}&var-host=${__field.labels.host:percentencode}",
              "targetBlank": false,
              "oneClick": true
            }
          ]
        },
        "overrides": []
      },
      "maxDataPoints": 600,
      "interval": "30s",
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "colorMode": "background_solid",
        "graphMode": "none",
        "textMode": "name",
        "wideLayout": false,
        "justifyMode": "center"
      },
      "repeat": "zone",
      "repeatDirection": "h",
      "maxPerRow": 6
    },
    {
      "id": 5,
      "title": "CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 9
      },
      "description": "CPU execution time, excluding I/O wait and hypervisor steal.",
      "targets": [
        {
          "expr": "100 * avg by (cluster,zone,host,machine) (sum by (cluster,zone,host,machine,cpu) (rate(node_cpu_seconds_total{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\",host=~`${host:regex}`,mode=~\"user|nice|system|irq|softirq\"}[$__rate_interval])))",
          "refId": "A",
          "legendFormat": "{{zone}} \u00b7 {{machine}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 6,
      "title": "Available RAM",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 9
      },
      "description": "MemAvailable: memory available for applications, including reclaimable cache.",
      "targets": [
        {
          "expr": "node_memory_MemAvailable_bytes{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\",host=~`${host:regex}`}",
          "refId": "A",
          "legendFormat": "{{zone}} \u00b7 {{machine}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "Network",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 9
      },
      "description": "Download/RX above zero; upload/TX below zero. Host interfaces summed, virtual interfaces excluded to avoid counting overlay traffic twice.",
      "targets": [
        {
          "expr": "8 * sum by (cluster,zone,host,machine) (rate(node_network_receive_bytes_total{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\",host=~`${host:regex}`,device!~\"lo|veth.*|cali.*|cni.*|flannel.*|docker.*|br-.*|wg.*|kube.*|bond.*\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "\u2193 {{zone}} \u00b7 {{machine}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        },
        {
          "expr": "-8 * sum by (cluster,zone,host,machine) (rate(node_network_transmit_bytes_total{cluster=~\"${cluster:regex}\",zone=~\"${zone:regex}\",host=~`${host:regex}`,device!~\"lo|veth.*|cali.*|cni.*|flannel.*|docker.*|br-.*|wg.*|kube.*|bond.*\"}[$__rate_interval]))",
          "refId": "B",
          "legendFormat": "\u2191 {{zone}} \u00b7 {{machine}}",
          "range": true,
          "instant": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisCenteredZero": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
